{
  "name": "indent-lang",
  "version": "0.2.0",
  "description": "Indent Markup Language (.inml): parser, XPath-like node selector, and schema validation for a generic, human-friendly, indentation-based tree markup language (XML-light).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ludbek/indent.git",
    "directory": "indent-lang"
  },
  "author": {
    "name": "Suren Shrestha"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "indent-lang": "./bin/indent-lang.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./xpath": {
      "types": "./dist/xpath/index.d.ts",
      "import": "./dist/xpath/index.js",
      "require": "./dist/xpath/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.cjs"
    },
    "./schema/resolve": {
      "types": "./dist/schema/resolve.d.ts",
      "import": "./dist/schema/resolve.js",
      "require": "./dist/schema/resolve.cjs"
    },
    "./cst": {
      "types": "./dist/cstWalker.d.ts",
      "import": "./dist/cstWalker.js",
      "require": "./dist/cstWalker.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tree-sitter": "^0.25.0",
    "treesitter-indent": "^0.2.1"
  }
}

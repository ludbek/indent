{
  "name": "treesitter-indent",
  "version": "0.2.1",
  "description": "Tree-sitter grammar for Indent Markup Language (.inml)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ludbek/indent.git",
    "directory": "treesitter-indent"
  },
  "license": "MIT",
  "author": {
    "name": "Suren Shrestha"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "indent"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "queries/*",
    "src/**",
    "bindings/node/**",
    "binding.gyp",
    "*.wasm",
    "prebuilds/**"
  ],
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "dependencies": {
    "node-addon-api": "^8.3.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.25.8",
    "web-tree-sitter": "^0.27.0",
    "prebuildify": "^6.0.1"
  },
  "scripts": {
    "build": "tree-sitter build --wasm && npm run build:node",
    "build:wasm": "tree-sitter build --wasm",
    "build:node": "node-gyp-build",
    "prebuild:node": "prebuildify --napi --strip",
    "start": "tree-sitter playground",
    "test": "tree-sitter test && node --test bindings/node/binding_test.js && node test/parity.mjs"
  }
}

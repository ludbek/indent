{
  "name": "vscode-indent-lang",
  "private": true,
  "displayName": "Indent",
  "description": "Syntax highlighting for Indent Markup Language (.inml)",
  "version": "0.2.2",
  "publisher": "SurenShrestha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ludbek/indent.git",
    "directory": "vscode-indent-lang"
  },
  "author": {
    "name": "Suren Shrestha"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:indent",
    "onCommand:indent.insertNodeRef"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "indent",
        "aliases": [
          "Indent Markup Language",
          "indent"
        ],
        "extensions": [
          ".inml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "indent",
        "scopeName": "source.indent",
        "path": "./syntaxes/indent.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[indent]": {
        "editor.formatOnType": true
      }
    },
    "commands": [
      {
        "command": "indent.insertNodeRef",
        "title": "Indent: Insert Node Reference",
        "category": "Indent"
      }
    ],
    "keybindings": [
      {
        "command": "indent.insertNodeRef",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == indent"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "indent.insertNodeRef",
          "when": "editorLangId == indent",
          "group": "9_cutcopypaste"
        }
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.24.2",
    "indent-language-server": "^0.2.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "vscode:prepublish": "npm run build",
    "package": "node ./scripts/package.js",
    "publish:vsce": "node ./scripts/publish.js",
    "test:local": "node ./scripts/test-local.js",
    "test": "npm run build && node test/continuation-indent.test.js && node test/insert-node-ref-contributions.test.js && node test/tmgrammar.test.js && node test/smoke-test.js && node test/smoke-test-file.js ../indent-parser/test/fixtures/sample.inml"
  }
}

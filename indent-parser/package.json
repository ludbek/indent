{
  "name": "indent-parser",
  "version": "0.1.0",
  "description": "Parser for a generic, human-friendly, indentation-based tree markup language (XML-light), Indent Markup Language (.inml).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "indent-parser": "./bin/indent-parser.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "indent-language-server",
  "version": "0.2.2",
  "description": "Language Server Protocol implementation for Indent Markup Language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ludbek/indent.git",
    "directory": "indent-language-server"
  },
  "author": {
    "name": "Suren Shrestha"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "indent-language-server": "./bin/indent-lsp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-wasm.js",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "indent-lang": "^0.3.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "web-tree-sitter": "^0.27.0"
  }
}
